      "kind": "custom",
      "refersTo": "composer",
      "description": "Single-line starting height with a circular submit control vertically centered on the right.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-composer-field\" rows=\"1\" aria-label=\"Message teammate\" placeholder=\"Message teammate…\"></textarea><button class=\"ds-composer-send\" aria-label=\"Send message\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 19V5m-7 7 7-7 7 7\"/></svg></button></div>",
      "css": ".ds-composer{font-family:var(--font-sans,Arial,sans-serif);font-size:14px;line-height:20px;letter-spacing:-.01em;position:relative;max-width:896px;border:1px solid var(--input,#ffffff24);border-radius:24px;background:var(--muted,#2b2b2b);color:var(--foreground,#f2f2f2);transition:border-color 180ms ease-out,box-shadow 180ms ease-out;} .ds-composer-field{box-sizing:border-box;font-family:var(--font-sans,Arial,sans-serif);font-size:14px;line-height:20px;letter-spacing:-.01em;display:block;width:100%;min-height:40px;padding:10px 56px 10px 12px;resize:none;field-sizing:content;background:transparent;border:0;color:inherit;} .ds-composer-field::placeholder{color:var(--muted-foreground,#a6a6a6);} .ds-composer-field:focus-visible{outline:none;} .ds-composer:focus-within{border-color:var(--ring,#bcbcbc);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,#bcbcbc) 50%,transparent);} .ds-composer-send{position:absolute;right:8px;top:50%;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:1px solid transparent;border-radius:50%;background:var(--primary,#f5f5f5);color:var(--primary-foreground,#161615);cursor:pointer;} .ds-composer-send:hover{background:color-mix(in oklch,var(--primary,#f5f5f5) 80%,transparent);} .ds-composer-send:focus-visible{outline:none;border-color:var(--ring,#bcbcbc);box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,#bcbcbc) 50%,transparent);} .ds-composer-send:active{transform:translateY(calc(-50% + 1px));} @media(max-width:639px){.ds-composer-field{font-size:16px;}} @media(prefers-reduced-motion:reduce){.ds-composer{transition:none;}}"
    }
