      "html": "<section class=\"ds-card\"><h3 class=\"ds-card-title\">Teammate details</h3><p class=\"ds-card-copy\">Name, role, and working instructions.</p></section>",
      "css": ".ds-card{font-family:var(--font-sans,Arial,sans-serif);font-size:14px;line-height:20px;letter-spacing:-.01em;display:flex;flex-direction:column;gap:16px;padding:16px;border-radius:var(--radius-xl,1.225rem);background:var(--card,#202020);color:var(--card-foreground,#f2f2f2);box-shadow:0 0 0 1px color-mix(in oklch,var(--foreground,#f2f2f2) 10%,transparent);overflow:hidden;} .ds-card-title{margin:0;font-size:16px;line-height:1.375;font-weight:500;} .ds-card-copy{margin:0;color:var(--muted-foreground,#a6a6a6);}"
