  "narrative": {
    "northStar": "The charcoal conversation workspace",
    "overview": "Krafty extends the user-pinned Grok Bot reference and the existing Krafty landing into a compact, full-height application. The charcoal conversation workspace pairs quiet neutral surfaces, white pill actions, the landing’s self-hosted face, and source-native organic characters. Conversation and the current teammate provide the visual center; navigation, tools, and account controls remain compact.\n\nDark is the default, with an explicit light theme using the same semantic component roles. Characters supply personality in teammate identities, welcome, empty, and authentication surfaces. Larger decorative characters stay outside ordinary message text. Existing user-selected DiceBear identities remain valid alongside the native characters.",
    "keyCharacteristics": [
      "Layered charcoal surfaces and restrained neutral borders.",
      "White primary actions, rounded controls, and visible keyboard focus.",
      "Narrow conversation measure with a compact bottom composer.",
      "Source-native teammate identities and selective, reduced-motion-aware animation.",
      "Persistent desktop navigation and accessible mobile overlays."
    ],
    "rules": [
      {
        "name": "The neutral chrome rule",
        "body": "Keep workspace chrome on the semantic neutral palette. Character color identifies a teammate; it does not recolor the entire application.",
        "section": "colors"
      },
      {
        "name": "The conversation measure rule",
        "body": "Keep message content inside the existing narrow conversation column while allowing the composer a wider measure. Do not stretch ordinary messages across the available desktop width.",
        "section": "typography"
      },
      {
        "name": "The tonal depth rule",
        "body": "Use surface tone and quiet borders for ordinary workspace depth. Reserve ambient shadow for floating overlays rather than adding lift to every card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic theme variables and the bundled landing face.",
      "Do retain the compact centered identity pill, narrow message column, and wider bottom composer.",
      "Do keep avatar identity intact across pinned tiles, rows, headers, and group messages.",
      "Do keep mobile navigation reachable and the live computer in a full-screen phone view.",
      "Do preserve visible focus, real loading and failure states, readable form controls, and reduced-motion behavior.",
      "Do reuse the existing Questionnaire for setup choices and the shared bot settings form for subsequent edits."
    ],
    "donts": [
      "Don’t replace the local display face with a system display font or introduce a competing accent palette.",
      "Don’t use oversized decorative characters inside ordinary conversation messages.",
      "Don’t add hard offset shadows to the charcoal workspace.",
      "Don’t show invented conversations, billing data, connected services, or successful work as application state.",
      "Don’t turn the isolated pinned role micro-label into the application’s reusable type scale."
    ]
  }
}
